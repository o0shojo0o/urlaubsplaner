{
  "name": "urlaubsplaner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch backend/src/dev.js",
    "dev:web": "npm run dev -w frontend",
    "build": "prisma generate && npm run build -w frontend",
    "start": "node --env-file-if-exists=.env backend/src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "bootstrap": "node --env-file-if-exists=.env scripts/bootstrap-admin.js",
    "demo": "node --env-file-if-exists=.env prisma/seed.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "eslint .",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "predb:migrate": "node --env-file-if-exists=.env scripts/prepare-db.js",
    "benchmark": "node scripts/benchmark.js",
    "restore:check": "node scripts/restore-check.js",
    "format": "prettier --write backend frontend/src scripts tests *.js *.json prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.1",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "prisma": "7.10.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.1",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "vitest": "^5.0.5"
  }
}
